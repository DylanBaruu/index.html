<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<meta name="claude:viewport-fit-sides" content="cover">
<title>Operación Heladera</title>
<style>
:root{--bg:#f5f7fa;--card:#fff;--tx:#1a1f2b;--mut:#5c6678;--ac:#0e7c86;--ok:#1a8f4c;--ko:#d6364a;--bd:#d8dde6;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#12161d;--card:#1c222c;--tx:#eef1f6;--mut:#9aa5b8;--ac:#35c2cf;--ok:#3ccf7a;--ko:#ff5c70;--bd:#2f3745}}
:root[data-theme="dark"]{--bg:#12161d;--card:#1c222c;--tx:#eef1f6;--mut:#9aa5b8;--ac:#35c2cf;--ok:#3ccf7a;--ko:#ff5c70;--bd:#2f3745}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--tx);font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;font-size:19px;display:flex;justify-content:center}
.w{width:100%;max-width:520px;padding:16px}
h1{font-size:36px;margin:8px 0}
.card{background:var(--card);border:1px solid var(--bd);border-radius:16px;padding:18px;margin:12px 0}
.bar{display:flex;justify-content:space-between;font-weight:700;font-size:20px}
.t{height:8px;background:var(--bd);border-radius:6px;overflow:hidden;margin:10px 0}
.t i{display:block;height:100%;width:100%;background:var(--ac)}
.item{text-align:center}
.item .e{height:150px;display:flex;align-items:center;justify-content:center;background:#fff;border-radius:12px;padding:8px}.item .e img{max-height:100%;max-width:100%;object-fit:contain}
.item .n{font-size:28px;font-weight:700;margin-top:4px}
.item .h{color:var(--mut);font-size:17px;min-height:24px}
.fr{position:relative;background:linear-gradient(145deg,#ffffff,#eceff2 55%,#dfe3e8);border-radius:20px 20px 14px 14px;padding:14px 22px 14px 14px;border:1px solid #c5ccd3;box-shadow:0 12px 22px rgba(0,0,0,.28),inset 0 2px 4px #fff;margin:14px 0 22px}
.fr .foot{position:absolute;bottom:-9px;width:34px;height:9px;border-radius:0 0 6px 6px;background:#4a4f57}
.fr .foot.l{left:30px}.fr .foot.r{right:30px}
.frz{position:relative;height:92px;margin:0 0 10px;border-radius:12px;border:2px solid #cbd2d9;border-bottom-width:5px;background:linear-gradient(180deg,#fff,#eef1f4);box-shadow:inset 0 2px 5px rgba(255,255,255,.9);display:flex;align-items:center;justify-content:space-around;padding:0 14px 0 8px;font-size:30px}
.frz::after,.fr::after{content:"";position:absolute;right:-8px;width:8px;border-radius:5px;background:linear-gradient(90deg,#f1f3f5,#8d96a1);box-shadow:1px 2px 3px rgba(0,0,0,.3)}
.frz::after{top:14px;height:56px;right:-13px}
.fr::after{top:130px;height:170px;right:6px}
.frz span{display:block;filter:drop-shadow(1px 3px 2px rgba(0,0,0,.35))}
.frz .m1{transform:rotate(-12deg)}.frz .m2{transform:rotate(9deg)}.frz .m3{transform:rotate(-5deg)}
.frz .fl{width:46px;height:32px;border-radius:5px;background:linear-gradient(180deg,#74acdf 0 33%,#fff 33% 67%,#74acdf 67%);position:relative;transform:rotate(7deg);border:1px solid rgba(0,0,0,.15)}
.frz .fl::after{content:"";position:absolute;left:50%;top:50%;width:9px;height:9px;margin:-4px 0 0 -4px;border-radius:50%;background:#f6b40e}
.frz .nt{width:46px;height:56px;background:repeating-linear-gradient(180deg,#fff59d 0 11px,#e9dd7d 11px 12px);transform:rotate(-4deg);box-shadow:1px 3px 5px rgba(0,0,0,.3)}
.frz .nt::before{content:"";display:block;width:12px;height:12px;margin:-5px auto 0;border-radius:50%;background:#e53935;box-shadow:0 2px 2px rgba(0,0,0,.35)}
.frz .pl{font-size:20px;align-self:flex-start;margin-top:8px;opacity:.7}
.in{display:grid;grid-template-columns:1fr 84px;gap:8px;height:390px}
.cab{display:grid;grid-template-rows:1fr 1fr 1fr 118px;background:radial-gradient(ellipse at 50% 0,#fffef8,#f1f0e8);border-radius:10px;border:4px solid #d3d9df;box-shadow:inset 0 0 14px rgba(0,0,0,.14);overflow:hidden}
.dr{background:linear-gradient(180deg,#fffef8,#f1f0e8);border-radius:10px;border:4px solid #d3d9df;box-shadow:inset 0 0 14px rgba(0,0,0,.14);display:flex;overflow:hidden}
.zn{position:relative;font:inherit;border:0;cursor:pointer;display:flex;flex-wrap:wrap;align-content:flex-end;align-items:flex-end;justify-content:center;gap:2px;padding:4px 6px 12px;background:transparent;border-bottom:7px solid #bfe0ea;box-shadow:0 5px 6px -2px rgba(0,0,0,.25),inset 0 -10px 12px -8px rgba(160,215,230,.7)}
.zn:hover:not(:disabled){background:rgba(255,255,255,.7)}
.zn.cj{border:0;border-top:5px solid #9fb8aa;background:linear-gradient(180deg,rgba(214,238,222,.9),rgba(160,205,178,.95));box-shadow:inset 0 0 0 3px rgba(255,255,255,.45),inset 0 -10px 14px rgba(70,120,90,.25);margin:0 5px;border-radius:10px 10px 6px 6px;padding-top:30px}
.zn.cj::before{content:"🥬 🍎";position:absolute;top:5px;left:0;right:0;text-align:center;font-size:20px;opacity:.55;filter:grayscale(.2)}
.zn.cj::after{content:"";position:absolute;top:30px;left:50%;width:54px;height:8px;margin-left:-27px;background:linear-gradient(#6f8b7b,#9fb8aa);border-radius:5px;box-shadow:inset 0 2px 3px rgba(0,0,0,.35)}
.zn.cj img{height:40px}
.zn.pt{border:0;width:100%;box-shadow:none;background:repeating-linear-gradient(180deg,transparent 0 94px,rgba(175,205,218,.95) 94px 112px);align-content:flex-end;padding-bottom:26px;position:relative}
.zn.pt::before{content:"🍾";position:absolute;top:44px;left:6px;font-size:26px;opacity:.4}
.zn.pt::after{content:"🥫";position:absolute;top:156px;right:8px;font-size:24px;opacity:.4}
.zn:not(.cj):not(.pt)::before{content:"";position:absolute;left:0;right:0;bottom:-7px;height:7px;background:linear-gradient(90deg,#8fa5b1 0 8px,transparent 8px calc(100% - 8px),#8fa5b1 calc(100% - 8px))}
.zn.ok{background:rgba(60,207,122,.5)!important;animation:p .6s}
.zn.ko{background:rgba(255,92,112,.5)!important;animation:sh .4s}
@keyframes p{50%{transform:scale(1.04)}}@keyframes sh{25%{transform:translateX(-5px)}75%{transform:translateX(5px)}}
.zn img{height:46px;max-width:78px;object-fit:contain}.pt img{height:auto;max-width:68px;max-height:46px}
.b{background:var(--ac);color:#fff;border:0;border-radius:14px;font:inherit;font-weight:700;font-size:21px;padding:14px;cursor:pointer;text-align:center;width:100%;margin-top:10px}
.fb{border-left:5px solid var(--bd);padding-left:12px;font-size:19px;line-height:1.45}
.fb.ok{border-color:var(--ok)}.fb.ko{border-color:var(--ko)}
.hide{display:none}
.big{font-size:56px;text-align:center}
p{line-height:1.5}
.item .e img{touch-action:none;cursor:grab;user-select:none;-webkit-user-select:none;-webkit-user-drag:none}
.ghost{position:fixed;z-index:60;pointer-events:none;height:90px;max-width:130px;object-fit:contain;transform:translate(-50%,-60%);filter:drop-shadow(0 8px 8px rgba(0,0,0,.4))}
.zn.over{background:rgba(14,124,134,.35)!important;outline:3px dashed var(--ac);outline-offset:-3px}
.ov{position:fixed;inset:0;z-index:50;background:rgba(0,0,0,.5);display:flex;align-items:center;justify-content:center;padding:16px}
.ov.hide{display:none}
.box{background:var(--card);color:var(--tx);border:1px solid var(--bd);border-radius:18px;padding:20px;width:100%;max-width:480px;max-height:88vh;overflow:auto;box-shadow:0 20px 50px rgba(0,0,0,.45)}
body{padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){color-scheme:dark}}
:root[data-theme="dark"]{color-scheme:dark}
</style><div class="w">

<div id="s0">
<h1>🧊 Operación Heladera</h1>
<div class="card"><p>Volviste del supermercado y tenés que ordenar las compras en <b>la heladera de tu casa</b>. Guardá cada alimento en el lugar correcto: arrastralo hasta ahí o tocá directamente el lugar.</p>
<p>Se cuentan tus <b>errores</b>: cada uno es alguien de tu familia con dolor de panza toda la noche. Intentá terminar con cero. 🚫</p>
<p style="color:var(--mut);font-size:17px">Tip: el orden importa de arriba hacia abajo. Pensá en qué pasa si algo gotea.</p>
<button class="b" onclick="start()">Empezar a guardar</button></div>
</div>

<div id="s1" class="hide">
<div class="bar"><span id="v"></span><span id="r"></span><span id="p"></span></div>

<div class="card item"><div class="e" id="e"></div><div class="n" id="n"></div><div class="h" id="h"></div></div>
<div class="fr"><div class="foot l"></div><div class="foot r"></div><div class="frz"><div class="pl">❄️</div><span class="m1">🧉</span><span class="fl"></span><span class="nt"></span><span class="m2">🍕</span><span class="m3">☀️</span></div><div class="in"><div class="cab" id="cab"></div><div class="dr" id="dr"></div></div></div>
<div id="ov" class="ov hide"><div class="box"><div id="fb" class="fb"></div><button id="nx" class="b" onclick="next()">Siguiente</button></div></div>

</div>

<div id="s2" class="hide">
<div class="card"><div class="big" id="ee"></div><h1 id="et" style="text-align:center"></h1>
<p id="ed" style="text-align:center"></p>
<p style="text-align:center;font-size:20px"><b id="es"></b> puntos</p>
<button class="b" onclick="start()">Jugar de nuevo</button></div>
<div class="card"><b>Regla de oro:</b><p style="margin:6px 0 0">Lo que se come sin cocinar va arriba. Lo crudo que gotea va abajo y tapado. Si dudás, preguntate: ¿qué cae sobre qué?</p></div>
</div>

</div>
<script>
const Z=[{k:"a",n:"el estante de arriba"},{k:"m",n:"el estante del medio"},{k:"b",n:"el estante de abajo"},{k:"c",n:"el cajón de frutas y verduras"},{k:"p",n:"la puerta"}];
let placed={};
function buildFridge(){
 const mk=(k,c)=>`<button class="zn ${c||""}" data-k="${k}" aria-label="${Z.find(z=>z.k===k).n}" title="${Z.find(z=>z.k===k).n}" onclick="pick('${k}')">${(placed[k]||[]).map(x=>`<img src="${IMG[x]}" alt="">`).join("")}</button>`;
 $("cab").innerHTML=mk("a")+mk("m")+mk("b")+mk("c","cj");
 $("dr").innerHTML=mk("p","pt")}
const I=[
["huevos","Huevos crudos","b","En su envase original, dentro de la heladera y separados de alimentos listos para consumir.","Apoyarlos directamente sobre comida preparada o guardarlos donde puedan romperse y derramarse.","¡Cuidado! La cáscara puede transportar microorganismos, incluida Salmonella. Conservá los huevos en su envase y evitá que entren en contacto con otros alimentos."],
["pollocrudo","Pollo crudo","b","En un recipiente cerrado que contenga sus líquidos.","Arriba de verduras, postres o comida cocida.","El pollo crudo puede contener bacterias. Si sus jugos caen sobre otro alimento, pueden contaminarlo."],
["comidacocida","Comida cocida sobrante","a","En un recipiente limpio, cerrado y poco profundo.","Debajo de carne cruda o en un recipiente abierto.","La comida cocida ya está lista para consumir. Mantenela protegida y refrigerala cuanto antes, sin dejarla más de dos horas a temperatura ambiente."],
["carne","Carne vacuna cruda","b","Tapada, separada de otros alimentos y con sus líquidos contenidos.","Junto a una ensalada lista para comer o encima de comida cocida.","La carne cruda debe estar separada de los alimentos listos para consumir. ¡Evitá que sus jugos contaminen el resto de la heladera!"],
["ensalada","Ensalada preparada","a","En un recipiente limpio y cerrado, por encima de las carnes crudas.","Debajo del pollo crudo o en contacto con sus líquidos.","Como se consume sin cocinarse, hay que protegerla de cualquier fuente de contaminación."],
["lacteos","Leche y yogur","m","En una zona interior fría, respetando las indicaciones del envase.","Dejarlos fuera de la heladera o junto a derrames de alimentos crudos.","Los lácteos necesitan mantenerse refrigerados. Guardalos bien cerrados y revisá sus fechas de vencimiento."],
["verduras","Frutas y verduras frescas","c","En los cajones destinados a frutas y verduras, separadas de las carnes crudas.","En contacto con líquidos de carne o pollo.","Lavá y sanitizá las frutas y verduras."],
["pollococido","Pollo cocido","a","En un recipiente limpio y cerrado, separado del pollo crudo.","En la misma bandeja que el pollo crudo sin lavar y desinfectar previamente.","Cocinar elimina muchos microorganismos, pero el alimento puede volver a contaminarse si entra en contacto con superficies o alimentos crudos."],
["fiambre","Queso y fiambre","m","En envases cerrados, separados de las carnes crudas.","En una bandeja donde haya líquidos de alimentos crudos.","Como estos alimentos suelen consumirse directamente, protegé su superficie del contacto con alimentos crudos."],
["aderezos","Aderezos y salsas","p","En la puerta, si el producto tolera esa ubicación y el envase indica que debe refrigerarse.","Dejar abiertos los envases o usar utensilios contaminados para servirlos.","Muchos aderezos pueden guardarse en la puerta. Respetá las indicaciones de conservación de cada producto."]];
const IMG={"huevos": "data:image/webp;base64,", "pollocrudo": "data:image/webp;base64,", "comidacocida": "data:image/webp;base64,", "carne": "data:image/webp;base64,", "ensalada": "data:image/webp;base64,", "lacteos": "data:image/webp;base64,", "verduras": "data:image/webp;base64,", "pollococido": "data:image/webp;base64,", "fiambre": "data:image/webp;base64,", "aderezos": "data:image/webp;base64,"};
const $=i=>document.getElementById(i);
let q,i,errs,score,streak,tm,left,ans;
function show(s){["s0","s1","s2"].forEach(x=>$(x).classList.toggle("hide",x!==s))}
function start(){placed={};q=[...I].sort(()=>Math.random()-.5);i=0;errs=0;score=0;streak=0;show("s1");load()}
function hud(){$("v").textContent="❌ Errores: "+errs;$("r").textContent=streak>1?"🔥 x"+streak:"";$("p").textContent=score+" pts"}
function load(){
 const it=q[i];ans=false;hud();
 $("e").innerHTML=`<img src="${IMG[it[0]]}" alt="">`;$("n").textContent=it[1];$("h").textContent="Alimento "+(i+1)+" de "+q.length+" · arrastralo o tocá dónde va";
 $("ov").classList.add("hide");
 buildFridge();
}
function pick(k){
 if(ans)return;ans=true;
 const it=q[i],good=k===it[2];
 if(k){(placed[k]=placed[k]||[]).push(it[0])}
 buildFridge();
 document.querySelectorAll(".zn").forEach(b=>{b.disabled=true;if(b.dataset.k===it[2])b.classList.add("ok");else if(b.dataset.k===k)b.classList.add("ko")});
 const fb=$("fb");fb.classList.remove("ok","ko");$("ov").classList.remove("hide");snd(good);
 if(good){streak++;const pts=10+Math.min(streak-1,5)*2;score+=pts;fb.classList.add("ok");
  fb.innerHTML="<b>✅ ¡Bien! +"+pts+"</b>"+(streak>=2?"<br><b>🔥 ¡Racha de "+streak+" aciertos seguidos!</b>":"")+"<br>"+it[5]+"<br><br><b>📍 Va en "+Z.find(z=>z.k===it[2]).n+".</b><br><b>Correcto:</b> "+it[3]}
 else{streak=0;errs++;fb.classList.add("ko");
  fb.innerHTML="<b>"+"❌ Ahí no."+"</b> La zona correcta quedó marcada en verde.<br>"+it[5]+"<br><br><b>📍 Va en "+Z.find(z=>z.k===it[2]).n+".</b><br><b>Correcto:</b> "+it[3]+"<br><b>Incorrecto:</b> "+it[4]}
 hud();$("nx").textContent=i>=q.length-1?"Ver resultado":"Siguiente"}
function next(){i++;if(i>=q.length)end();else load()}
function end(){
 show("s2");$("es").textContent=score;
 let e,t,d;
 if(errs===0){e="🏆";t="Heladera perfecta";d="Cero errores. En tu casa todos duermen tranquilos."}
 else if(errs<=2){e="👍";t="Muy buen cocinero";d="Pocos errores, pero uno solo ya puede arruinar una comida. Repasá los que fallaste."}
 else if(errs<=5){e="😬";t="Zafaste a medias";d="Hay varios cruces de contaminación posibles. Probá de nuevo."}
 else{e="🍝";t="¡Se te mojaron los fideos!";d="Demasiados errores: el líquido de la carne goteó sobre los fideos y la cena se arruinó. Intentá otra vez."}
 $("ee").textContent=e;$("et").textContent=t;$("ed").textContent=d+" ("+errs+" errores)"}

let AC;
function tone(f,t0,d,ty){const o=AC.createOscillator(),g=AC.createGain();o.type=ty;o.frequency.value=f;g.gain.setValueAtTime(.15,t0);g.gain.exponentialRampToValueAtTime(.001,t0+d);o.connect(g);g.connect(AC.destination);o.start(t0);o.stop(t0+d)}
function snd(ok){try{AC=AC||new (window.AudioContext||window.webkitAudioContext)();if(AC.state==="suspended")AC.resume();const n=AC.currentTime;
 if(ok){tone(660,n,.12,"sine");tone(880,n+.12,.22,"sine");if(streak>=1)tone(1175,n+.3,.25,"sine")}
 else{tone(200,n,.18,"sawtooth");tone(130,n+.18,.32,"sawtooth")}}catch(e){}}
let drag=null;
function zoneAt(x,y){const el=document.elementFromPoint(x,y);return el&&el.closest?el.closest(".zn"):null}
function mv(ev){drag.g.style.left=ev.clientX+"px";drag.g.style.top=ev.clientY+"px";
 const z=zoneAt(ev.clientX,ev.clientY);document.querySelectorAll(".zn.over").forEach(b=>b.classList.remove("over"));if(z)z.classList.add("over")}
function endDrag(ev,drop){if(!drag)return;const z=drop?zoneAt(ev.clientX,ev.clientY):null;
 drag.g.remove();drag.im.style.opacity="";document.querySelectorAll(".zn.over").forEach(b=>b.classList.remove("over"));drag=null;
 if(z)pick(z.dataset.k)}
$("e").addEventListener("pointerdown",ev=>{if(ans||drag)return;const im=ev.target.closest("img");if(!im)return;ev.preventDefault();
 const g=im.cloneNode();g.className="ghost";document.body.appendChild(g);im.style.opacity=".35";drag={g,im};mv(ev)});
window.addEventListener("pointermove",ev=>{if(drag){ev.preventDefault();mv(ev)}},{passive:false});
window.addEventListener("pointerup",ev=>endDrag(ev,true));
window.addEventListener("pointercancel",ev=>endDrag(ev,false));
</script>

</body></html>
